        <mxCell id="a1" value="#27d4ff&#xa;cyan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c1018;strokeColor=#27d4ff;strokeWidth=2;fontColor=#27d4ff;fontFamily=Menlo;fontSize=12" vertex="1" parent="1"><mxGeometry x="640" y="290" width="150" height="70" as="geometry" /></mxCell>

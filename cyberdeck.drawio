        <mxCell id="pgc3" value="child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c1018;strokeColor=#55ff99;fontColor=#e6edf7;fontFamily=Menlo;fontSize=15" vertex="1" parent="pg"><mxGeometry x="400" y="70" width="170" height="80" as="geometry" /></mxCell>

        <mxCell id="pnote" value="NOTE / ASIDE&#xa;&lt;font style=&quot;font-size:13px;color:#7f8ea3&quot;&gt;dashed grey box for commentary that&#xa;is not part of the flow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0a0d15;strokeColor=#3a4658;dashed=1;fontColor=#8fa3bf;fontFamily=Menlo;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10" vertex="1" parent="1">

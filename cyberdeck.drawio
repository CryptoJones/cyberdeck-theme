        <mxCell id="s2" value="#0a0d15&#xa;group fill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0a0d15;strokeColor=#3a4658;fontColor=#d7e0ee;fontFamily=Menlo;fontSize=12" vertex="1" parent="1"><mxGeometry x="800" y="200" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="s3" value="#0c1018&#xa;node fill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0c1018;strokeColor=#3a4658;fontColor=#d7e0ee;fontFamily=Menlo;fontSize=12" vertex="1" parent="1"><mxGeometry x="960" y="200" width="150" height="70" as="geometry" /></mxCell>
